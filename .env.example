# Copy this file to .env and fill in real values. .env is gitignored and
# loaded automatically by config.py via python-dotenv — never commit it.

# --- Binance REST API ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram notifications (optional; leave empty to disable) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude API, used for news sentiment scoring (optional) ---
ANTHROPIC_API_KEY=

# --- Logging (optional overrides) ---
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
